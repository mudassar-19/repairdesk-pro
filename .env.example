# Firebase web app config — Project Settings > General > Your apps (web) in the
# Firebase console. These are public client identifiers, not secrets; Firebase's
# security model relies on Auth rules, not hiding these values. Used for login/
# session only — no Storage or Firestore field here since this app doesn't use
# either (business data stays local-only; cloud backups go to each client's own
# Google Drive, see the Google Drive block below).
#
# Copy this file to `.env` (gitignored) and fill in the real project values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Drive OAuth client for scheduled cloud backups — Google Cloud
# Console > APIs & Services > Credentials > Create Credentials > OAuth
# client ID > Application type "Desktop app" (after enabling the Drive API
# and configuring the OAuth consent screen with the drive.file scope,
# published to Production). One client ID/secret per app build; each client's
# own Drive account is authorized separately, at runtime, via the "Connect
# Google Drive" button in Settings. MAIN_VITE_ (not VITE_) keeps this out of
# the renderer bundle — only the main process reads it.
MAIN_VITE_GOOGLE_DRIVE_CLIENT_ID=
MAIN_VITE_GOOGLE_DRIVE_CLIENT_SECRET=
