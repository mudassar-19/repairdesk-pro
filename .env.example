# Firebase web app config — Project Settings > General > Your apps (web) in the
# Firebase console. These are public client identifiers, not secrets; Firebase's
# security model relies on Auth/Firestore rules, not hiding these values.
#
# Copy this file to `.env` (gitignored) and fill in the real project values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
